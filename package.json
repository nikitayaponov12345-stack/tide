{
  "name": "tide",
  "private": true,
  "version": "0.0.25",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "data": "node tools/data-check.mjs",
    "build": "tsc --noEmit && vite build && node tools/size-report.mjs",
    "preview": "vite preview --host --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "sim": "vitest run --config vitest.sim.config.ts",
    "check": "npm run data && npm run test && npm run build && npm run e2e",
    "publish": "node tools/publish.mjs"
  },
  "dependencies": {
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
